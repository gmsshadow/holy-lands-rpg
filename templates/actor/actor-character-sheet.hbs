<div class="sheet-content">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Character Name"/></h1>

    <div class="char-info-panel">
      <div class="ci-row"><label>Player</label><input type="text" name="system.playerName" value="{{system.playerName}}" placeholder="Player name"/></div>
      <div class="ci-row"><label>Gender</label>
        <select name="system.gender">
          <option value="male" {{#if (eq system.gender "male")}}selected{{/if}}>Male</option>
          <option value="female" {{#if (eq system.gender "female")}}selected{{/if}}>Female</option>
        </select>
      </div>

      <div class="ci-row ci-span ci-class-row"><label>Class</label>
        <div class="ci-value">
          {{#if classItem}}
          <span class="class-item-display" data-item-id="{{classItem.id}}">
            <a data-action="itemEdit" title="Open class"><strong>{{classItem.name}}</strong></a>
            <a data-action="itemDelete" title="Remove class"><i class="fas fa-times"></i></a>
          </span>
          {{else}}
          {{#if legacyClassLabel}}<span class="legacy-class" title="Assigned before class items existed - choose a class item to enable full automation">{{legacyClassLabel}} <span class="hint">(legacy)</span></span>{{/if}}
          <button type="button" data-action="chooseClass" title="Pick a class legal for this Stature from the Character Classes compendium (p.53)"><i class="fas fa-scroll"></i> Choose Class</button>
          {{/if}}
        </div>
      </div>
      {{#if classStatureInvalid}}<p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{classItem.name}} cannot be this Stature (Ch7)</p>{{/if}}
      {{#if unmetRequirements.length}}
      {{#each unmetRequirements}}<p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{this.label}} AV {{this.current}} below the required {{this.min}} (Ch7)</p>{{/each}}
      {{#if attributesLocked}}<button type="button" data-action="rollStep2A" title="Reroll unmet class Attributes with the Stature dice until requirements are met (p.53)"><i class="fas fa-rotate"></i> Step 2A Reroll</button>
      {{else}}<p class="hint">Roll Attributes (Step 2) first, then Step 2A rerolls become available.</p>{{/if}}
      {{/if}}

      <div class="ci-row ci-span ci-stature-row"><label>Stature</label>
        <div class="ci-value">
          <select name="system.stature" {{#if attributesLocked}}disabled{{/if}}>{{selectOptions statures selected=system.stature}}</select>
          {{#unless attributesLocked}}<button type="button" data-action="rollCreationAttributes" title="Roll all twelve Attributes from the p.53 Stature table, then lock"><i class="fas fa-dice"></i> Roll Attributes</button>
          {{else}}{{#if isGM}}<a class="hint" data-action="unlockCreationAttributes" title="Rac override: allow a fresh Step 2 roll"><i class="fas fa-lock-open"></i> unlock</a>{{/if}}{{/unless}}
        </div>
      </div>

      <div class="ci-row ci-level-row"><label>Level</label>
        <div class="ci-value">
          <input type="number" name="system.level" value="{{system.level}}" class="ci-level-input"/>
          {{#if classItem}}
          {{#if canLevelUp}}<button type="button" class="level-up-ready" data-action="levelUp" title="XP threshold reached - roll class Life/Faith dice and advance a level"><i class="fas fa-arrow-up"></i> Level Up!</button>{{/if}}
          {{#unless startingRolled}}
          {{#if attributesLocked}}<button type="button" data-action="rollStartingLifeFaith" title="Roll starting Life and Faith from the class formulas (locks after rolling)"><i class="fas fa-dice"></i> Start</button>
          {{else}}<span class="hint" title="Roll Attributes (Step 2) first">roll Attributes first</span>{{/if}}
          {{else}}{{#if isGM}}<a class="hint" data-action="unlockStartingRoll" title="Rac override: allow a fresh starting Life &amp; Faith roll"><i class="fas fa-lock-open"></i> unlock start</a>{{/if}}{{/unless}}
          {{#if isGM}}<a class="hint" data-action="levelUp" title="Rac override: force a manual level-up regardless of XP"><i class="fas fa-arrow-up"></i> force</a>{{/if}}
          {{/if}}
        </div>
      </div>

      <div class="ci-row ci-xp-row"><label>XP</label>
        <div class="ci-value">
          <input type="number" name="system.experience" value="{{system.experience}}" class="ci-xp-input"/>
          {{#if nextLevelXp}}<span class="xp-hint {{#if canLevelUp}}xp-ready{{/if}}" title="EXP needed to reach the next level (Genesis p.62)">/ {{nextLevelXp}} for L{{nextLevel}}</span>
          {{else}}<span class="xp-hint hint">max level</span>{{/if}}
        </div>
      </div>

      <div class="ci-row"><label>Native Land</label><input type="text" name="system.nativeLand" value="{{system.nativeLand}}" placeholder="—"/></div>
      <div class="ci-row"><label>Languages</label><input type="text" name="system.languageGroup" value="{{system.languageGroup}}" placeholder="—"/></div>

      <div class="ci-row ci-span ci-physical"><label>Age <span class="hint">({{system.detailsValidation.ageMin}}–{{system.detailsValidation.ageMax}})</span></label>
        <div class="ci-value ci-physical-values">
          <input type="number" name="system.age" value="{{system.age}}" title="Age"/>
          <span class="ci-sep">H</span><input type="text" name="system.height" value="{{system.height}}" title="Height" placeholder="Height"/>
          <span class="ci-sep">W</span><input type="text" name="system.weight" value="{{system.weight}}" title="Weight" placeholder="Weight"/>
          <button type="button" data-action="rollDetails" title="Step 5: roll Height, Weight, Native Land, and Language Group (editable afterwards)"><i class="fas fa-dice"></i></button>
        </div>
      </div>
    </div>

    {{#if system.detailsValidation.ageOutOfRange}}
    <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> Age {{system.age}} is outside the p.56 range {{system.detailsValidation.ageMin}}–{{system.detailsValidation.ageMax}} (Rac may adjust Attributes for very young/old characters)</p>
    {{/if}}

    <div class="resource">
      <div class="resource-group">
        <label>Life</label>
        <input type="number" name="system.life.value" value="{{system.life.value}}" placeholder="0"/>
        <span> / </span>
        <input type="number" name="system.life.max" value="{{system.life.max}}" placeholder="10"/>
      </div>
      <div class="resource-group">
        <label>Faith</label>
        <input type="number" name="system.faith.value" value="{{system.faith.value}}" placeholder="0"/>
        <span> / </span>
        <input type="number" name="system.faith.max" value="{{system.faith.max}}" placeholder="5"/>
      </div>
    </div>
  </div>
</header>

<nav class="sheet-tabs tabs" data-group="primary">
  <a class="item {{tabs.attributes.cssClass}}" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
  <a class="item {{tabs.skills.cssClass}}" data-action="tab" data-group="primary" data-tab="skills">Skills</a>
  <a class="item {{tabs.combat.cssClass}}" data-action="tab" data-group="primary" data-tab="combat">Combat</a>
  <a class="item {{tabs.equipment.cssClass}}" data-action="tab" data-group="primary" data-tab="equipment">Equipment</a>
  <a class="item {{tabs.miracles.cssClass}}" data-action="tab" data-group="primary" data-tab="miracles">Miracles</a>
  <a class="item {{tabs.biography.cssClass}}" data-action="tab" data-group="primary" data-tab="biography">Biography</a>
</nav>

<section class="sheet-body">
  <div class="tab attributes {{tabs.attributes.cssClass}}" data-group="primary" data-tab="attributes">
    <div class="core-stats-row">

      <div class="core-col attributes-col">
        <h3>Attributes</h3>
        <div class="stat-list">
          {{#each system.attributes as |attr key|}}
          <div class="stat-line" data-action="rollAttribute" data-attribute="{{key}}" title="Roll {{attr.label}} (d12)">
            <label>{{attr.label}}</label>
            <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}" onclick="event.stopPropagation()"/>
            <i class="fas fa-dice-d12 roll-glyph"></i>
          </div>
          {{/each}}
        </div>
      </div>

      <div class="core-col abilities-col">
        <h3>Abilities</h3>
        <div class="stat-list">
          {{#each system.abilities as |ability key|}}
          <div class="stat-line ability-line" data-action="rollAbility" data-ability="{{key}}" title="Roll {{ability.label}} (d20)">
            <div class="ability-label-group">
              <label>{{ability.label}}</label>
              <span class="ability-formula">{{lookup ../abilityFormulas key}}</span>
            </div>
            <span class="stat-pf">+{{ability.mod}}</span>
            <input type="number" name="system.abilities.{{key}}.bonus" value="{{ability.bonus}}" placeholder="0" title="Bonus" onclick="event.stopPropagation()"/>
            <i class="fas fa-dice-d20 roll-glyph"></i>
          </div>
          {{/each}}
        </div>
      </div>

      <div class="core-col saves-col">
        <h3>Saving Throws
          {{#unless saveBonusChosen}}
          <button type="button" data-action="chooseSaveBonus" title="Step 4: choose one Saving Throw to receive the creation +1 (then locks)"><i class="fas fa-plus"></i></button>
          {{else}}{{#if isGM}}<a class="hint" data-action="unlockSaveBonus" title="Rac override: unlock"><i class="fas fa-lock-open"></i></a>{{/if}}{{/unless}}
        </h3>
        {{#each system.savesValidation.warnings}}
        <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>
        {{/each}}
        <div class="stat-list">
          {{#each system.saves as |save key|}}
          <div class="stat-line" data-action="rollSave" data-save="{{key}}" title="Roll {{save.label}} (DF {{save.df}})">
            <label>{{save.label}} <span class="save-df">({{save.df}})</span></label>
            <input type="number" name="system.saves.{{key}}.value" value="{{save.value}}" placeholder="0" onclick="event.stopPropagation()"/>
            <i class="fas fa-dice-d20 roll-glyph"></i>
          </div>
          {{/each}}
        </div>
      </div>

    </div>

    {{#if attrBonuses.rows.length}}
    <div class="attr-bonus-panel">
      <h3>Attribute Bonuses <span class="hint">(Step 10, p.60 - {{attrBonuses.pending}} pending)</span></h3>
      {{#each attrBonuses.rows}}
      <div class="attr-bonus-row {{#if this.remaining}}has-pending{{/if}}">
        <span class="ab-attr">{{this.label}} {{this.av}}</span>
        <span class="ab-effect">{{this.effect}}</span>
        <span class="ab-count">{{this.used}}/{{this.earned}}</span>
        {{#if this.remaining}}
        <button type="button" data-action="applyAttrBonus" data-attr="{{this.key}}" title="Apply one bonus">
          <i class="fas fa-plus"></i> Apply
        </button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>

  <div class="tab skills {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
    <p class="hint">Drag skills from a compendium, or use the Add buttons. Open a skill to set its PF and links.</p>
    {{#if hasBasicSkillList}}
    {{#unless talentsCraftsChosen}}
    <div class="step6-banner">
      <span>Step 6: choose 7 Gifts, 5 Talents &amp; 3 Crafts (all +2) from the class pool?</span>
      <button type="button" data-action="chooseBasicSkills" title="Adventurer/Fighter: pick all skills from one pool, all at +2 PF">
        <i class="fas fa-list-check"></i> Choose Skills
      </button>
    </div>
    {{else}}
    {{#if isGM}}
    <p class="hint"><a data-action="unlockTalentsCrafts"><i class="fas fa-lock-open"></i> unlock skill choice</a></p>
    {{/if}}
    {{/unless}}
    {{/if}}
    {{#if hasClassGifts}}
    {{#unless giftsGranted}}
    <div class="step6-banner">
      <span>Step 6: grant this class's Gifts automatically?</span>
      <button type="button" data-action="grantGifts" title="Add the class's listed Gifts as skill items at +3 (+2 for Adventurer/Fighter)">
        <i class="fas fa-gift"></i> Grant Class Gifts
      </button>
    </div>
    {{/unless}}
    {{/if}}
    {{#if hasTalentCraftList}}
    {{#unless talentsCraftsChosen}}
    <div class="step6-banner">
      <span>Step 6: choose 5 Talents (+2) and 3 Crafts (+1) from the class list?</span>
      <button type="button" data-action="chooseTalentsCrafts" title="Pick Talents and Crafts from the class's Ch7 skill list">
        <i class="fas fa-list-check"></i> Choose Talents &amp; Crafts
      </button>
    </div>
    {{else}}
    {{#if isGM}}
    <p class="hint"><a data-action="unlockTalentsCrafts"><i class="fas fa-lock-open"></i> unlock Talents &amp; Crafts choice</a></p>
    {{/if}}
    {{/unless}}
    {{/if}}
    <div class="skills-columns">
      <div class="skill-column">
        <div class="skill-col-header"><h3>Gifts</h3><span class="pf-label">PF</span></div>
        <ol class="skill-item-list">
          {{#each gifts as |item|}}
          <li class="skill-row" data-item-id="{{item.id}}">
            <a class="skill-name" data-action="itemEdit" title="Open skill">{{item.name}}</a>
            <span class="skill-pf-plus">+</span>
            <span class="skill-pf-val">{{item.system.pf}}</span>
            <a class="item-control" data-action="rollSkill" title="Roll"><i class="fas fa-dice-d20"></i></a>
            <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ol>
        <a class="item-control skill-add" data-action="addSkill" data-section="gift" title="Add Gift"><i class="fas fa-plus"></i> Add</a>
      </div>
      <div class="skill-column">
        <div class="skill-col-header"><h3>Talents</h3><span class="pf-label">PF</span></div>
        <ol class="skill-item-list">
          {{#each talents as |item|}}
          <li class="skill-row" data-item-id="{{item.id}}">
            <a class="skill-name" data-action="itemEdit" title="Open skill">{{item.name}}</a>
            <span class="skill-pf-plus">+</span>
            <span class="skill-pf-val">{{item.system.pf}}</span>
            <a class="item-control" data-action="rollSkill" title="Roll"><i class="fas fa-dice-d20"></i></a>
            <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ol>
        <a class="item-control skill-add" data-action="addSkill" data-section="talent" title="Add Talent"><i class="fas fa-plus"></i> Add</a>
      </div>
      <div class="skill-column">
        <div class="skill-col-header"><h3>Crafts</h3><span class="pf-label">PF</span></div>
        <ol class="skill-item-list">
          {{#each crafts as |item|}}
          <li class="skill-row" data-item-id="{{item.id}}">
            <a class="skill-name" data-action="itemEdit" title="Open skill">{{item.name}}</a>
            <span class="skill-pf-plus">+</span>
            <span class="skill-pf-val">{{item.system.pf}}</span>
            <a class="item-control" data-action="rollSkill" title="Roll"><i class="fas fa-dice-d20"></i></a>
            <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ol>
        <a class="item-control skill-add" data-action="addSkill" data-section="craft" title="Add Craft"><i class="fas fa-plus"></i> Add</a>
      </div>
    </div>
  </div>

  <div class="tab combat {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
    <h3>Ready Weapons</h3>
    <ol class="items-list ready-weapons">
      {{#each innateAttacks as |atk|}}
      <li class="item flexrow innate-attack" data-innate="{{atk.kind}}">
        <div class="item-name">
          <div class="item-image"><img src="{{atk.img}}" title="{{atk.name}}" width="24" height="24"/></div>
          <h4>{{atk.name}}{{#unless atk.trained}} <span class="hint">(untrained)</span>{{/unless}}</h4>
        </div>
        <div class="item-props">{{atk.displayDamage}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="rollAttack" title="Roll Attack"><i class="fas fa-dice-d20"></i></a>
          <a class="item-control" data-action="rollDamage" title="Roll Damage"><i class="fas fa-dice"></i></a>
        </div>
      </li>
      {{/each}}
      {{#each equippedWeapons as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">{{#if item.displayDamage}}{{item.displayDamage}}{{else}}{{item.system.damage}}{{/if}}{{#if item.system.isShield}} (shield){{/if}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="rollAttack" title="Roll Attack"><i class="fas fa-dice-d20"></i></a>
          <a class="item-control" data-action="rollDamage" title="Roll Damage"><i class="fas fa-dice"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>

    <div class="active-ws-bar">
      <label>Active attack type:</label>
      <select name="system.activeWeaponSkill">
        {{#each system.weaponSkills as |ws key|}}
        <option value="{{key}}" {{#if (eq ../system.activeWeaponSkill key)}}selected{{/if}}>{{ws.label}}</option>
        {{/each}}
      </select>
      <span class="active-atr" title="AtR remaining on the active attack type">
        AtR {{activeAtR.current}}/{{activeAtR.max}}
      </span>
    </div>

    <div class="conditions-bar">
      <span class="conditions-label">Conditions:</span>
      {{#each activeConditions}}
      <span class="condition-chip" title="{{this.note}}">
        {{this.label}}{{#if this.bodyPart}}: {{this.bodyPart}}{{#unless this.isSet}} (set within {{this.setByDays}}d){{else}} (set, {{this.unusableWeeks}}wk){{/unless}}{{/if}}{{#if this.diesInDays}} ({{this.diesInDays}}d to live){{/if}}
        <a data-action="clearCondition" data-condition="{{this.key}}" title="Clear"><i class="fas fa-xmark"></i></a>
      </span>
      {{else}}
      <span class="hint">none</span>
      {{/each}}
      <span class="condition-controls">
        <a data-action="rest" title="Rest (restore Life/Faith over hours)"><i class="fas fa-bed"></i> Rest</a>
        <a data-action="applyDamageManual" title="Apply an arbitrary amount of damage or healing"><i class="fas fa-heart-crack"></i> Damage</a>
        <a data-action="applyCondition" title="Apply a condition (Rac)"><i class="fas fa-plus"></i></a>
        <a data-action="rollInjury" title="Roll on the Severity of Injury table"><i class="fas fa-dice-d20"></i> Injury</a>
        <a data-action="rollInjuryLocation" title="Roll Critical Injury location"><i class="fas fa-crosshairs"></i> Location</a>
      </span>
    </div>
    {{#if hasBroken}}
    <div class="recovery-bar">
      <span class="recovery-label">Broken injury:</span>
      {{#unless brokenIsSet}}
      <a data-action="setInjury" title="Set the injury (Medical) - stops it turning Terminal"><i class="fas fa-kit-medical"></i> Set injury</a>
      <a data-action="brokenToTerminal" title="Deadline passed unset - becomes Terminal"><i class="fas fa-skull"></i> Deadline passed (to Terminal)</a>
      {{else}}
      <span class="hint">Set - healing; harming it risks permanent disability.</span>
      {{/unless}}
    </div>
    {{/if}}
    {{#if isDyingOrComatose}}
    <div class="recovery-bar">
      <span class="recovery-label">Recovery:</span>
      <a data-action="saveVsDeath" title="Roll Save vs Death"><i class="fas fa-skull"></i> Save vs Death</a>
      {{#if inComa}}<a data-action="advanceComa" title="Advance the coma (lose 1 Life/hour)"><i class="fas fa-hourglass-half"></i> Advance coma</a>{{/if}}
    </div>
    {{/if}}

    <h3>Defense</h3>
    <div class="stat-strip defense-strip">
      <div class="strip-cell">
        <span class="strip-label" title="Natural Defense">nDEF</span>
        <input type="number" name="system.defense.nDEF" value="{{system.defense.nDEF}}"/>
      </div>
      <div class="strip-cell">
        <span class="strip-label" title="Armor Defense Total">aDEF</span>
        <span class="strip-value">{{system.defense.aDEFTotal}}</span>
      </div>
      <div class="strip-cell">
        <span class="strip-label" title="Total Defense">tDEF</span>
        <span class="strip-value">{{system.defense.tDEF}}</span>
      </div>
      <div class="strip-cell">
        <span class="strip-label" title="Armor Penalty Total">Pen</span>
        <span class="strip-value">{{system.defense.armorPenaltyTotal}}</span>
      </div>
    </div>

    <div class="combat-actions" style="display:flex; gap:8px; margin:6px 0;">
      <button type="button" data-action="forfeitAdvantage" title="Double your next Dodge/Defend Bonus this Round">
        <i class="fas fa-shield-halved"></i> Forfeit Advantage
      </button>
      <button type="button" data-action="declareRetreat" title="Forfeit Advantage and attacks; successfully Dodge to break away">
        <i class="fas fa-person-running"></i> Declare Retreat
      </button>
    </div>

    <h3>Combat Bonuses
      <span class="budget {{#if system.combatValidation.ca.over}}over{{/if}}">
        {{system.combatValidation.ca.spent}} / {{system.combatValidation.ca.budget}} pts
      </span>
    </h3>
    {{#each system.combatValidation.ca.warnings}}
    <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>
    {{/each}}
    {{#unless system.combatValidation.ca.hasSkill}}
    <p class="hint">Add the "Combat Abilities" skill to your Gifts, Talents, or Crafts to gain +1 points to distribute here (Step 7, p.59).</p>
    {{/unless}}
    <div class="stat-strip combat-bonus-strip">
      <div class="strip-cell">
        <span class="strip-label">Advantage</span>
        <input type="number" name="system.combat.advantageBonus" value="{{system.combat.advantageBonus}}"/>
      </div>
      <div class="strip-cell">
        <span class="strip-label">Dodge</span>
        <input type="number" name="system.combat.dodgeBonus" value="{{system.combat.dodgeBonus}}"/>
      </div>
      <div class="strip-cell">
        <span class="strip-label">Defend</span>
        <input type="number" name="system.combat.defendBonus" value="{{system.combat.defendBonus}}"/>
      </div>
      <div class="strip-cell">
        <span class="strip-label">Damage</span>
        <input type="number" name="system.combat.damageBonus" value="{{system.combat.damageBonus}}"/>
      </div>
    </div>

    <h3>Weapon Skills</h3>
    <p class="hint">Each "WS &lt;name&gt;" skill in your Gifts/Talents/Crafts grants its PF in +1s for that Weapon Skill's ATT/CRI/SPC, and +1 AtR (Step 8, p.59). All AtR pools drop together when you act, so changing weapons doesn't grant extra attacks. Set your Active attack type at the top of this tab.</p>
    {{#each system.weaponSkills as |ws key|}}
    {{#with (lookup ../system.combatValidation.ws key) as |v|}}
    <div class="weapon-skill">
      <h4>{{ws.label}}
        <span class="budget {{#if v.over}}over{{/if}}">{{v.spent}} / {{v.budget}} pts</span>
        <span class="budget {{#if v.atrMismatch}}over{{/if}}" title="Expected AtR">AtR {{ws.atRMax}} (exp {{v.expectedAtR}})</span>
      </h4>
      {{#each v.warnings}}
      <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>
      {{/each}}
      <div class="stat-strip ws-strip">
        <div class="strip-cell">
          <span class="strip-label" title="Attack Bonus">ATT</span>
          <input type="number" name="system.weaponSkills.{{key}}.attackBonus" value="{{ws.attackBonus}}"/>
        </div>
        <div class="strip-cell">
          <span class="strip-label" title="Critical Bonus">CRI</span>
          <input type="number" name="system.weaponSkills.{{key}}.criticalBonus" value="{{ws.criticalBonus}}"/>
        </div>
        <div class="strip-cell">
          <span class="strip-label" title="Special Bonus">SPC</span>
          <input type="number" name="system.weaponSkills.{{key}}.specialBonus" value="{{ws.specialBonus}}"/>
        </div>
        <div class="strip-cell ws-atr-cell">
          <span class="strip-label" title="Actions this Round (current / max)">AtR</span>
          <div class="ws-atr-inputs">
            <input type="number" name="system.weaponSkills.{{key}}.atRCurrent" value="{{ws.atRCurrent}}"/>
            <span>/</span>
            <input type="number" name="system.weaponSkills.{{key}}.atRMax" value="{{ws.atRMax}}"/>
          </div>
        </div>
      </div>
    </div>
    {{/with}}
    {{/each}}
  </div>

  <div class="tab equipment {{tabs.equipment.cssClass}}" data-group="primary" data-tab="equipment">
    {{#if hasStartingKit}}
    {{#unless equipmentGranted}}
    <div class="step6-banner">
      <span>Step 9: grant this class's starting weapons, armor &amp; equipment?</span>
      <button type="button" data-action="grantEquipment" title="Add the class's starting kit from the compendia (rolls dice quantities, then locks)">
        <i class="fas fa-shield"></i> Grant Starting Equipment
      </button>
    </div>
    {{else}}
    {{#if isGM}}
    <p class="hint"><a data-action="unlockEquipment"><i class="fas fa-lock-open"></i> unlock starting-equipment grant</a></p>
    {{/if}}
    {{/unless}}
    {{/if}}
    <h3>Currency</h3>
    <div class="currency">
      <div class="currency-item">
        <label>Gold</label>
        <input type="number" name="system.currency.gold" value="{{system.currency.gold}}"/>
      </div>
      <div class="currency-item">
        <label>Silver</label>
        <input type="number" name="system.currency.silver" value="{{system.currency.silver}}"/>
      </div>
    </div>

    <h3>Weapons</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="weapon" title="Create Weapon">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each weapons as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">{{#if item.displayDamage}}{{item.displayDamage}}{{else}}{{item.system.damage}}{{/if}}{{#if item.system.isShield}} (shield){{/if}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="rollAttack" title="Roll Attack"><i class="fas fa-dice-d20"></i></a>
          <a class="item-control" data-action="rollDamage" title="Roll Damage"><i class="fas fa-dice"></i></a>
          <a class="item-control equip-toggle {{#if item.system.equipped}}equipped{{/if}}" data-action="toggleEquip" title="{{#if item.system.equipped}}Equipped - click to unequip{{else}}Not equipped - click to equip{{/if}}"><i class="fas {{#if item.system.equipped}}fa-shield{{else}}fa-shield-halved{{/if}}"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>

    <h3>Armor</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="armor" title="Create Armor">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each armor as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">
          AP: {{item.system.ap}} |
          aDEF: {{#if item.system.currentADEF}}{{item.system.currentADEF}}{{else}}{{item.system.aDEF}}{{/if}} |
          CAP: {{item.system.CAP}} |
          PEN: {{#if item.system.currentPEN}}{{item.system.currentPEN}}{{else}}{{item.system.PEN}}{{/if}}
        </div>
        <div class="item-controls">
          <a class="item-control equip-toggle {{#if item.system.equipped}}equipped{{/if}}" data-action="toggleEquip" title="{{#if item.system.equipped}}Equipped - click to unequip{{else}}Not equipped - click to equip{{/if}}"><i class="fas {{#if item.system.equipped}}fa-shield{{else}}fa-shield-halved{{/if}}"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>

    <h3>Equipment</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="equipment" title="Create Equipment">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each equipment as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">Qty: {{item.system.quantity}}</div>
        <div class="item-controls">
          <a class="item-control equip-toggle {{#if item.system.equipped}}equipped{{/if}}" data-action="toggleEquip" title="{{#if item.system.equipped}}Equipped - click to unequip{{else}}Not equipped - click to equip{{/if}}"><i class="fas {{#if item.system.equipped}}fa-shield{{else}}fa-shield-halved{{/if}}"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="tab miracles {{tabs.miracles.cssClass}}" data-group="primary" data-tab="miracles">
    {{#if miracleClass}}
    <div class="step6-banner">
      <span>{{miracleGuidance}}</span>
    </div>
    <div class="miracle-actions">
      <button type="button" data-action="addMiracle" data-miracle-type="high" title="Add a High Miracle from the compendium">
        <i class="fas fa-plus"></i> Add High Miracle
      </button>
      <button type="button" data-action="addMiracle" data-miracle-type="clerical" title="Add a Clerical Miracle from the compendium">
        <i class="fas fa-plus"></i> Add Clerical Miracle
      </button>
      {{#if (eq miracleClass "cleric")}}
      <button type="button" data-action="grantClericMiracles" title="Add all Level 1 Clerical Miracles at once">
        <i class="fas fa-layer-group"></i> Grant all Clerical
      </button>
      {{/if}}
    </div>
    {{/if}}
    <h3>Miracles</h3>

    <h4 class="miracle-subhead">High Miracles
      <a class="item-control" data-action="itemCreate" data-type="miracle" data-miracle-type="high" title="Create High Miracle"><i class="fas fa-plus"></i></a>
    </h4>
    <ol class="items-list">
      {{#each highMiracles as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">FC: {{item.system.faithCost}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="castMiracle" title="Cast Miracle"><i class="fas fa-hands-praying"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="item"><span class="hint">No High miracles.</span></li>
      {{/each}}
    </ol>

    <h4 class="miracle-subhead">Clerical Miracles
      <a class="item-control" data-action="itemCreate" data-type="miracle" data-miracle-type="clerical" title="Create Clerical Miracle"><i class="fas fa-plus"></i></a>
    </h4>
    <ol class="items-list">
      {{#each clericalMiracles as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">FC: {{item.system.faithCost}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="castMiracle" title="Cast Miracle"><i class="fas fa-hands-praying"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="item"><span class="hint">No Clerical miracles.</span></li>
      {{/each}}
    </ol>

    <h3>Blessings
      <span class="budget {{#if system.blessingsValidation.over}}over{{/if}}" title="Starting: 2 Blessings if Faith 5+, else 0 (p.60). Gain 2 more each time max Faith crosses a multiple of 5 (p.62).">
        {{system.blessingsValidation.held}} of {{system.blessingsValidation.entitled}}
      </span>
      {{#if system.blessingsValidation.blessingsType}}
      <span class="hint">{{system.blessingsValidation.blessingsType}}</span>
      {{/if}}
      {{#if system.blessingsValidation.remaining}}
      <button type="button" data-action="rollBlessings" title="Roll new Blessings on the class table (p.61)">
        <i class="fas fa-dice"></i> Roll {{system.blessingsValidation.remaining}}
      </button>
      {{/if}}
    </h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="blessing" title="Create Blessing">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each blessings as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-controls">
          <a class="item-control" data-action="useBlessing" title="Use Blessing"><i class="fas fa-cross"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="tab biography {{tabs.biography.cssClass}}" data-group="primary" data-tab="biography">
    <h3>Sins
      <span class="hint">(VIR grants {{system.detailsValidation.expectedSins}})</span>
      <button type="button" data-action="rollSinsPhobias" data-kind="sins" title="Roll Sins by Virtue AV (p.56) - overwrites the list">
        <i class="fas fa-dice-d20"></i> Roll
      </button>
    </h3>
    <div class="skills-list">
      {{#each system.sins as |sin index|}}
      <div class="skill">
        <input type="text" class="char-array-field" data-array="sins" data-index="{{index}}" value="{{sin}}" placeholder="Sin"/>
        <a class="item-control" data-action="charArrayDelete" data-array="sins" data-index="{{index}}" title="Remove"><i class="fas fa-trash"></i></a>
      </div>
      {{/each}}
      <a class="item-control" data-action="charArrayAdd" data-array="sins" title="Add sin"><i class="fas fa-plus"></i> Add sin</a>
    </div>
    {{#if sinEffects.length}}
    <div class="sin-effects">
      {{#each sinEffects}}
      <p class="sin-effect"><strong>{{this.name}}:</strong> {{this.text}} {{#if this.auto}}<span class="sin-auto" title="Enforced automatically">[auto]</span>{{else}}<span class="sin-rac" title="Rac/roleplay - not auto-enforced">[Rac]</span>{{/if}}</p>
      {{/each}}
    </div>
    {{/if}}

    <h3>Phobias
      <span class="hint">(WIL grants {{system.detailsValidation.expectedPhobias}})</span>
      <button type="button" data-action="rollSinsPhobias" data-kind="phobias" title="Roll Phobias by Will AV (p.56) - overwrites the list">
        <i class="fas fa-dice-d20"></i> Roll
      </button>
    </h3>
    <div class="skills-list">
      {{#each system.phobias as |phobia index|}}
      <div class="skill">
        <input type="text" class="char-array-field" data-array="phobias" data-index="{{index}}" value="{{phobia}}" placeholder="Phobia"/>
        <a class="item-control" data-action="charArrayDelete" data-array="phobias" data-index="{{index}}" title="Remove"><i class="fas fa-trash"></i></a>
      </div>
      {{/each}}
      <a class="item-control" data-action="charArrayAdd" data-array="phobias" title="Add phobia"><i class="fas fa-plus"></i> Add phobia</a>
    </div>

    <h3>Biography</h3>
    <div class="editor-content">
      <prose-mirror name="system.biography" value="{{system.biography}}" toggled>
        {{{enrichedBiography}}}
      </prose-mirror>
    </div>
  </div>
</section>
</div>
