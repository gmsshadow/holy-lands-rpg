<div class="sheet-content">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Character Name"/></h1>
    <div class="resource">
      <div class="resource-group">
        <label>Life</label>
        <input type="number" name="system.life.value" value="{{system.life.value}}" placeholder="0"/>
        <span> / </span>
        <input type="number" name="system.life.max" value="{{system.life.max}}" placeholder="10"/>
      </div>
      <div class="resource-group">
        <label>Faith</label>
        <input type="number" name="system.faith.value" value="{{system.faith.value}}" placeholder="0"/>
        <span> / </span>
        <input type="number" name="system.faith.max" value="{{system.faith.max}}" placeholder="5"/>
      </div>
    </div>
    <div class="character-info">
      <div class="info-group">
        <label>Class</label>
        {{#if classItem}}
        <div class="class-item-display" data-item-id="{{classItem.id}}">
          <a data-action="itemEdit" title="Open class"><strong>{{classItem.name}}</strong></a>
          <a data-action="itemDelete" title="Remove class"><i class="fas fa-times"></i></a>
        </div>
        {{#if classStatureInvalid}}
        <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{classItem.name}} cannot be this Stature (Ch7)</p>
        {{/if}}
        {{else}}
        <select name="system.class">
          {{selectOptions classes selected=system.class}}
        </select>
        <p class="hint">Drop a Class from the Character Classes compendium for full automation.</p>
        {{/if}}
      </div>
      <div class="info-group">
        <label>Stature</label>
        <select name="system.stature">
          {{selectOptions statures selected=system.stature}}
        </select>
      </div>
      <div class="info-group">
        <label>Level</label>
        <input type="number" name="system.level" value="{{system.level}}"/>
        {{#if classItem}}
        <button type="button" data-action="levelUp" title="Roll class Life/Faith dice and advance a level">
          <i class="fas fa-arrow-up"></i> Level Up
        </button>
        <button type="button" data-action="rollStartingLifeFaith" title="Roll starting Life and Faith (new characters)">
          <i class="fas fa-dice"></i> Start
        </button>
        {{/if}}
      </div>
      <div class="info-group">
        <label>XP</label>
        <input type="number" name="system.experience" value="{{system.experience}}"/>
      </div>
    </div>
    <div class="character-details">
      <div class="detail-group">
        <label>Age</label>
        <input type="number" name="system.age" value="{{system.age}}"/>
      </div>
      <div class="detail-group">
        <label>Gender</label>
        <input type="text" name="system.gender" value="{{system.gender}}"/>
      </div>
    </div>
  </div>
</header>

<nav class="sheet-tabs tabs" data-group="primary">
  <a class="item {{tabs.attributes.cssClass}}" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
  <a class="item {{tabs.skills.cssClass}}" data-action="tab" data-group="primary" data-tab="skills">Skills</a>
  <a class="item {{tabs.combat.cssClass}}" data-action="tab" data-group="primary" data-tab="combat">Combat</a>
  <a class="item {{tabs.equipment.cssClass}}" data-action="tab" data-group="primary" data-tab="equipment">Equipment</a>
  <a class="item {{tabs.miracles.cssClass}}" data-action="tab" data-group="primary" data-tab="miracles">Miracles</a>
  <a class="item {{tabs.biography.cssClass}}" data-action="tab" data-group="primary" data-tab="biography">Biography</a>
</nav>

<section class="sheet-body">
  <div class="tab attributes {{tabs.attributes.cssClass}}" data-group="primary" data-tab="attributes">
    <h3>Attributes</h3>
    <div class="attributes-grid">
      {{#each system.attributes as |attr key|}}
      <div class="attribute">
        <label>{{attr.label}}</label>
        <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}"/>
        <button type="button" data-action="rollAttribute" data-attribute="{{key}}">
          <i class="fas fa-dice-d12"></i> Roll
        </button>
      </div>
      {{/each}}
    </div>

    <h3>Abilities</h3>
    <div class="abilities-grid">
      {{#each system.abilities as |ability key|}}
      <div class="ability">
        <label>{{ability.label}}</label>
        <div class="ability-values">
          <span class="pf">PF: {{ability.mod}}</span>
          <input type="number" name="system.abilities.{{key}}.bonus" value="{{ability.bonus}}" placeholder="0" title="Bonus"/>
        </div>
        <button type="button" data-action="rollAbility" data-ability="{{key}}">
          <i class="fas fa-dice-d20"></i> Roll
        </button>
      </div>
      {{/each}}
    </div>

    <h3>Saving Throws</h3>
    <div class="saves-grid">
      {{#each system.saves as |save key|}}
      <div class="save">
        <label>{{save.label}} (DF {{save.df}})</label>
        <input type="number" name="system.saves.{{key}}.value" value="{{save.value}}" placeholder="0"/>
        <button type="button" data-action="rollSave" data-save="{{key}}">
          <i class="fas fa-dice-d20"></i> Roll
        </button>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="tab skills {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
    <h3>Gifts</h3>
    <div class="skills-list">
      {{#each system.skills.gifts as |skill key|}}
      <div class="skill">
        <input type="text" name="system.skills.gifts.{{key}}.name" value="{{skill.name}}" placeholder="Skill Name"/>
        <span class="skill-pf-plus">+</span>
        <input type="number" name="system.skills.gifts.{{key}}.value" value="{{skill.value}}" placeholder="0" title="Proficiency Factor (PF)" class="skill-pf"/>
        <button type="button" data-action="rollSkill" data-skill="gifts.{{key}}">
          <i class="fas fa-dice-d20"></i>
        </button>
      </div>
      {{/each}}
    </div>

    <h3>Talents</h3>
    <div class="skills-list">
      {{#each system.skills.talents as |skill key|}}
      <div class="skill">
        <input type="text" name="system.skills.talents.{{key}}.name" value="{{skill.name}}" placeholder="Skill Name"/>
        <span class="skill-pf-plus">+</span>
        <input type="number" name="system.skills.talents.{{key}}.value" value="{{skill.value}}" placeholder="0" title="Proficiency Factor (PF)" class="skill-pf"/>
        <button type="button" data-action="rollSkill" data-skill="talents.{{key}}">
          <i class="fas fa-dice-d20"></i>
        </button>
      </div>
      {{/each}}
    </div>

    <h3>Crafts</h3>
    <div class="skills-list">
      {{#each system.skills.crafts as |skill key|}}
      <div class="skill">
        <input type="text" name="system.skills.crafts.{{key}}.name" value="{{skill.name}}" placeholder="Skill Name"/>
        <span class="skill-pf-plus">+</span>
        <input type="number" name="system.skills.crafts.{{key}}.value" value="{{skill.value}}" placeholder="0" title="Proficiency Factor (PF)" class="skill-pf"/>
        <button type="button" data-action="rollSkill" data-skill="crafts.{{key}}">
          <i class="fas fa-dice-d20"></i>
        </button>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="tab combat {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
    <h3>Defense</h3>
    <div class="defense-stats">
      <div class="stat">
        <label>Natural Defense (nDEF)</label>
        <input type="number" name="system.defense.nDEF" value="{{system.defense.nDEF}}"/>
      </div>
      <div class="stat">
        <label>Armor Defense Total (aDEFTotal)</label>
        <span class="derived-value">{{system.defense.aDEFTotal}}</span>
      </div>
      <div class="stat">
        <label>Total Defense (tDEF)</label>
        <span class="derived-value">{{system.defense.tDEF}}</span>
      </div>
      <div class="stat">
        <label>Armor Penalty Total</label>
        <span class="derived-value">{{system.defense.armorPenaltyTotal}}</span>
      </div>
    </div>

    <div class="combat-actions" style="display:flex; gap:8px; margin:6px 0;">
      <button type="button" data-action="forfeitAdvantage" title="Double your next Dodge/Defend Bonus this Round">
        <i class="fas fa-shield-halved"></i> Forfeit Advantage
      </button>
      <button type="button" data-action="declareRetreat" title="Forfeit Advantage and attacks; successfully Dodge to break away">
        <i class="fas fa-person-running"></i> Declare Retreat
      </button>
    </div>

    <h3>Combat Bonuses
      <span class="budget {{#if system.combatValidation.ca.over}}over{{/if}}">
        {{system.combatValidation.ca.spent}} / {{system.combatValidation.ca.budget}} pts
      </span>
    </h3>
    {{#each system.combatValidation.ca.warnings}}
    <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>
    {{/each}}
    {{#unless system.combatValidation.ca.hasSkill}}
    <p class="hint">Add the "Combat Abilities" skill to your Gifts, Talents, or Crafts to gain +1 points to distribute here (Step 7, p.59).</p>
    {{/unless}}
    <div class="combat-stats">
      <div class="stat">
        <label>Advantage Bonus</label>
        <input type="number" name="system.combat.advantageBonus" value="{{system.combat.advantageBonus}}"/>
      </div>
      <div class="stat">
        <label>Dodge Bonus</label>
        <input type="number" name="system.combat.dodgeBonus" value="{{system.combat.dodgeBonus}}"/>
      </div>
      <div class="stat">
        <label>Defend Bonus</label>
        <input type="number" name="system.combat.defendBonus" value="{{system.combat.defendBonus}}"/>
      </div>
      <div class="stat">
        <label>Damage Bonus</label>
        <input type="number" name="system.combat.damageBonus" value="{{system.combat.damageBonus}}"/>
      </div>
    </div>

    <h3>Weapon Skills</h3>
    <p class="hint">Each "WS &lt;name&gt;" skill in your Gifts/Talents/Crafts grants its PF in +1s for that Weapon Skill's ATT/CRI/SPC, and +1 AtR (Step 8, p.59).</p>
    {{#each system.weaponSkills as |ws key|}}
    {{#with (lookup ../system.combatValidation.ws key) as |v|}}
    <div class="weapon-skill">
      <h4>{{ws.label}}
        <span class="budget {{#if v.over}}over{{/if}}">{{v.spent}} / {{v.budget}} pts</span>
        <span class="budget {{#if v.atrMismatch}}over{{/if}}" title="Expected AtR">AtR {{ws.atRMax}} (exp {{v.expectedAtR}})</span>
      </h4>
      {{#each v.warnings}}
      <p class="rules-warning"><i class="fas fa-triangle-exclamation"></i> {{this}}</p>
      {{/each}}
      <div class="ws-stats">
        <div class="ws-stat">
          <label>Attack Bonus</label>
          <input type="number" name="system.weaponSkills.{{key}}.attackBonus" value="{{ws.attackBonus}}"/>
        </div>
        <div class="ws-stat">
          <label>Critical Bonus</label>
          <input type="number" name="system.weaponSkills.{{key}}.criticalBonus" value="{{ws.criticalBonus}}"/>
        </div>
        <div class="ws-stat">
          <label>Special Bonus</label>
          <input type="number" name="system.weaponSkills.{{key}}.specialBonus" value="{{ws.specialBonus}}"/>
        </div>
        <div class="ws-stat">
          <label>AtR</label>
          <input type="number" name="system.weaponSkills.{{key}}.atRCurrent" value="{{ws.atRCurrent}}" style="width: 50px;"/>
          <span>/</span>
          <input type="number" name="system.weaponSkills.{{key}}.atRMax" value="{{ws.atRMax}}" style="width: 50px;"/>
        </div>
      </div>
    </div>
    {{/with}}
    {{/each}}
  </div>

  <div class="tab equipment {{tabs.equipment.cssClass}}" data-group="primary" data-tab="equipment">
    <h3>Currency</h3>
    <div class="currency">
      <div class="currency-item">
        <label>Gold</label>
        <input type="number" name="system.currency.gold" value="{{system.currency.gold}}"/>
      </div>
      <div class="currency-item">
        <label>Silver</label>
        <input type="number" name="system.currency.silver" value="{{system.currency.silver}}"/>
      </div>
    </div>

    <h3>Weapons</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="weapon" title="Create Weapon">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each weapons as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">{{item.system.damage}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="rollAttack" title="Roll Attack"><i class="fas fa-dice-d20"></i></a>
          <a class="item-control" data-action="rollDamage" title="Roll Damage"><i class="fas fa-dice"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>

    <h3>Armor</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="armor" title="Create Armor">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each armor as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">
          AP: {{item.system.ap}} |
          aDEF: {{#if item.system.currentADEF}}{{item.system.currentADEF}}{{else}}{{item.system.aDEF}}{{/if}} |
          CAP: {{item.system.CAP}} |
          PEN: {{#if item.system.currentPEN}}{{item.system.currentPEN}}{{else}}{{item.system.PEN}}{{/if}}
        </div>
        <div class="item-controls">
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>

    <h3>Equipment</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="equipment" title="Create Equipment">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each equipment as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">Qty: {{item.system.quantity}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="tab miracles {{tabs.miracles.cssClass}}" data-group="primary" data-tab="miracles">
    <h3>Miracles</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="miracle" title="Create Miracle">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each miracles as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-props">FC: {{item.system.faithCost}}</div>
        <div class="item-controls">
          <a class="item-control" data-action="castMiracle" title="Cast Miracle"><i class="fas fa-hands-praying"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>

    <h3>Blessings</h3>
    <ol class="items-list">
      <li class="item flexrow item-header">
        <div class="item-name">Name</div>
        <div class="item-controls">
          <a class="item-control" data-action="itemCreate" data-type="blessing" title="Create Blessing">
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each blessings as |item id|}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
          <h4>{{item.name}}</h4>
        </div>
        <div class="item-controls">
          <a class="item-control" data-action="useBlessing" title="Use Blessing"><i class="fas fa-cross"></i></a>
          <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
  </div>

  <div class="tab biography {{tabs.biography.cssClass}}" data-group="primary" data-tab="biography">
    <div class="editor-content">
      <prose-mirror name="system.biography" value="{{system.biography}}" toggled>
        {{{enrichedBiography}}}
      </prose-mirror>
    </div>
  </div>
</section>
</div>
