<div class="sheet-content">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="NPC Name"/></h1>
    <div class="resource">
      <div class="resource-group">
        <label>Life</label>
        <input type="number" name="system.life.value" value="{{system.life.value}}" placeholder="0"/>
        <span> / </span>
        <input type="number" name="system.life.max" value="{{system.life.max}}" placeholder="10"/>
      </div>
    </div>
    <div class="npc-info">
      <div class="info-group">
        <label>Level</label>
        <input type="number" name="system.level" value="{{system.level}}"/>
      </div>
      <div class="info-group">
        <label>Type</label>
        <input type="text" name="system.type" value="{{system.type}}"/>
      </div>
    </div>
  </div>
</header>

<section class="sheet-body">
  <div class="attributes-simple">
    <h3>Attributes</h3>
    <div class="attributes-grid">
      {{#each system.attributes as |attr key|}}
      <div class="attribute-simple">
        <label>{{attr.label}}</label>
        <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}"/>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="combat-simple">
    <h3>Defense</h3>
    <div class="defense-stats">
      <div class="stat">
        <label>nDEF</label>
        <input type="number" name="system.defense.nDEF" value="{{system.defense.nDEF}}"/>
      </div>
      <div class="stat">
        <label>tDEF</label>
        <span class="derived-value">{{system.defense.tDEF}}</span>
      </div>
    </div>
    <h3>Combat</h3>
    <div class="combat-stats">
      <div class="stat">
        <label>Advantage Bonus</label>
        <input type="number" name="system.combat.advantageBonus" value="{{system.combat.advantageBonus}}"/>
      </div>
      <div class="stat">
        <label>Dodge Bonus</label>
        <input type="number" name="system.combat.dodgeBonus" value="{{system.combat.dodgeBonus}}"/>
      </div>
      <div class="stat">
        <label>Defend Bonus</label>
        <input type="number" name="system.combat.defendBonus" value="{{system.combat.defendBonus}}"/>
      </div>
      <div class="stat">
        <label>Damage</label>
        <input type="text" name="system.combat.damage" value="{{system.combat.damage}}"/>
      </div>
    </div>
  </div>

  <div class="biography">
    <h3>Biography</h3>
    <prose-mirror name="system.biography" value="{{system.biography}}" toggled>
      {{{enrichedBiography}}}
    </prose-mirror>
  </div>
</section>
</div>
