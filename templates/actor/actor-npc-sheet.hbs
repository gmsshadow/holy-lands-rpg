<div class="sheet-content">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
  <div class="header-fields">
    <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="NPC Name"/></h1>
    <div class="npc-info">
      <div class="info-group">
        <label>Kind</label>
        <select name="system.npcKind">
          {{selectOptions npcKinds selected=system.npcKind}}
        </select>
      </div>
      <div class="info-group">
        <label>Category</label>
        <select name="system.category">
          {{selectOptions categories selected=system.category}}
        </select>
      </div>
      <div class="info-group">
        <label>Type</label>
        <input type="text" name="system.type" value="{{system.type}}" placeholder="e.g. Advanced Demon"/>
      </div>
      <div class="info-group">
        <label>Level</label>
        <input type="number" name="system.level" value="{{system.level}}"/>
      </div>
    </div>
    <div class="resource">
      <div class="resource-group">
        <label>Life</label>
        <input type="number" name="system.life.value" value="{{system.life.value}}"/>
        <span> / </span>
        <input type="number" name="system.life.max" value="{{system.life.max}}"/>
      </div>
      {{#if isMonster}}
      <div class="resource-group">
        <label>Range</label>
        <input type="text" name="system.lifeRange" value="{{system.lifeRange}}" placeholder="428-523"/>
      </div>
      <div class="resource-group">
        <label>Size</label>
        <input type="text" name="system.size" value="{{system.size}}" placeholder="8ft tall"/>
      </div>
      {{/if}}
    </div>
  </div>
</header>

<section class="sheet-body">
  <div class="conditions-bar">
    <span class="conditions-label">Conditions:</span>
    {{#each activeConditions}}
    <span class="condition-chip" title="{{this.note}}">
      {{this.label}}
      <a data-action="clearCondition" data-condition="{{this.key}}" title="Clear"><i class="fas fa-xmark"></i></a>
    </span>
    {{else}}
    <span class="hint">none</span>
    {{/each}}
    <span class="condition-controls">
      <a data-action="applyCondition" title="Apply a condition (Rac)"><i class="fas fa-plus"></i></a>
      <a data-action="rollInjury" title="Roll on the Severity of Injury table"><i class="fas fa-dice-d20"></i> Injury</a>
    </span>
  </div>

  <h3>Combat</h3>
  <div class="combat-stats npc-combat-line">
    <div class="stat">
      <label>ADV</label>
      <input type="number" name="system.combat.advantageBonus" value="{{system.combat.advantageBonus}}"/>
    </div>
    <div class="stat">
      <label>DOD</label>
      <input type="number" name="system.combat.dodgeBonus" value="{{system.combat.dodgeBonus}}"/>
    </div>
    <div class="stat">
      <label>DEF</label>
      <input type="number" name="system.combat.defendBonus" value="{{system.combat.defendBonus}}"/>
    </div>
    <div class="stat">
      <label>DAM</label>
      <input type="number" name="system.combat.damageBonus" value="{{system.combat.damageBonus}}"/>
    </div>
    <div class="stat">
      <label>nDEF</label>
      <input type="number" name="system.defense.nDEF" value="{{system.defense.nDEF}}"/>
    </div>
    <div class="stat">
      <label>tDEF</label>
      <span class="derived-value">{{system.defense.tDEF}}</span>
    </div>
  </div>
  <div class="npc-tdef-override">
    <label>tDEF override</label>
    <input type="number" name="system.defense.tDEFOverride" value="{{system.defense.tDEFOverride}}" placeholder="—"/>
    <label>Source</label>
    <input type="text" name="system.defense.tDEFSource" value="{{system.defense.tDEFSource}}" placeholder="hardened muscle and flesh"/>
    <span class="hint">Leave override blank to use nDEF + equipped armor.</span>
  </div>

  <h3>Notable Skills and Abilities</h3>
  <p class="hint">Drag skills from a compendium, or add a custom one. Open a skill to set its PF and links.</p>
  <ol class="skill-item-list npc-cs-list">
    {{#each notableSkills as |item|}}
    <li class="item skill-row" data-item-id="{{item.id}}">
      <span class="skill-name">{{item.name}}</span>
      <span class="skill-pf">+{{item.system.pf}}</span>
      <a class="item-control" data-action="rollSkill" data-item-id="{{item.id}}" title="Roll"><i class="fas fa-dice-d20"></i></a>
      <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
      <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
    </li>
    {{/each}}
  </ol>
  <a class="item-control" data-action="addCustomSkill" title="Add a custom skill"><i class="fas fa-plus"></i> Add custom skill</a>


  <h3>Weapon Skills (WS)</h3>
  <div class="active-ws-bar">
    <label>Active attack type:</label>
    <select name="system.activeWeaponSkill">
      {{#each system.weaponSkills as |ws key|}}
      <option value="{{key}}" {{#if (eq ../system.activeWeaponSkill key)}}selected{{/if}}>{{ws.label}}</option>
      {{/each}}
    </select>
    <span class="active-atr" title="AtR remaining on the active attack type">AtR {{activeAtR.current}}/{{activeAtR.max}}</span>
  </div>
  {{#each system.weaponSkills as |ws key|}}
  <div class="weapon-skill">
    <h4>{{ws.label}}</h4>
    <div class="ws-stats">
      <div class="ws-stat">
        <label>ATT</label>
        <input type="number" name="system.weaponSkills.{{key}}.attackBonus" value="{{ws.attackBonus}}"/>
      </div>
      <div class="ws-stat">
        <label>CRI</label>
        <input type="number" name="system.weaponSkills.{{key}}.criticalBonus" value="{{ws.criticalBonus}}"/>
      </div>
      <div class="ws-stat">
        <label>SPC</label>
        <input type="number" name="system.weaponSkills.{{key}}.specialBonus" value="{{ws.specialBonus}}"/>
      </div>
      <div class="ws-stat">
        <label>AtR</label>
        <input type="number" name="system.weaponSkills.{{key}}.atRCurrent" value="{{ws.atRCurrent}}" style="width: 50px;"/>
        <span>/</span>
        <input type="number" name="system.weaponSkills.{{key}}.atRMax" value="{{ws.atRMax}}" style="width: 50px;"/>
      </div>
    </div>
  </div>
  {{/each}}

  <h3>Weapons (DAM)</h3>
  <ol class="items-list">
    <li class="item flexrow item-header">
      <div class="item-name">Name</div>
      <div class="item-controls">
        <a class="item-control" data-action="itemCreate" data-type="weapon" title="Create Weapon">
          <i class="fas fa-plus"></i>
        </a>
      </div>
    </li>
    {{#each weapons as |item id|}}
    <li class="item flexrow" data-item-id="{{item.id}}">
      <div class="item-name">
        <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-props">{{item.system.damage}}</div>
      <div class="item-controls">
        <a class="item-control" data-action="rollAttack" title="Roll Attack"><i class="fas fa-dice-d20"></i></a>
        <a class="item-control" data-action="rollDamage" title="Roll Damage"><i class="fas fa-dice"></i></a>
        <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{/each}}
  </ol>

  <h3>Armor</h3>
  <ol class="items-list">
    <li class="item flexrow item-header">
      <div class="item-name">Name</div>
      <div class="item-controls">
        <a class="item-control" data-action="itemCreate" data-type="armor" title="Create Armor">
          <i class="fas fa-plus"></i>
        </a>
      </div>
    </li>
    {{#each armor as |item id|}}
    <li class="item flexrow" data-item-id="{{item.id}}">
      <div class="item-name">
        <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-props">
        AP: {{item.system.ap}} |
        aDEF: {{#if item.system.currentADEF}}{{item.system.currentADEF}}{{else}}{{item.system.aDEF}}{{/if}}
      </div>
      <div class="item-controls">
        <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{/each}}
  </ol>

  <h3>Miracles <span class="hint">(Faith {{system.faith.value}}/{{system.faith.max}})</span></h3>
  <p class="hint">Drag from the Miracles compendium, or create one. Mainly for Christian NPCs (evil clerics, saints).</p>
  <ol class="skill-item-list">
    {{#each miracles as |item|}}
    <li class="item skill-row" data-item-id="{{item.id}}">
      <span class="skill-name">{{item.name}} <span class="miracle-tag">{{#if (eq item.system.miracleType "clerical")}}Clerical{{else}}High{{/if}}</span></span>
      <span class="skill-pf">Fc {{item.system.faithCost}}</span>
      <a class="item-control" data-action="castMiracle" data-item-id="{{item.id}}" title="Cast Miracle"><i class="fas fa-hands-praying"></i></a>
      <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
      <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
    </li>
    {{/each}}
  </ol>
  <a class="item-control" data-action="itemCreate" data-type="miracle" title="Create a miracle"><i class="fas fa-plus"></i> Add miracle</a>

  <h3>Blessings</h3>
  <p class="hint">Drag from the Blessings compendium, or create one.</p>
  <ol class="skill-item-list">
    {{#each blessings as |item|}}
    <li class="item skill-row" data-item-id="{{item.id}}">
      <span class="skill-name">{{item.name}}</span>
      <span class="skill-pf">Fc {{item.system.faithCost}}</span>
      <a class="item-control" data-action="useBlessing" data-item-id="{{item.id}}" title="Use Blessing"><i class="fas fa-cross"></i></a>
      <a class="item-control" data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
      <a class="item-control" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
    </li>
    {{/each}}
  </ol>
  <a class="item-control" data-action="itemCreate" data-type="blessing" title="Create a blessing"><i class="fas fa-plus"></i> Add blessing</a>

  <h3>Saves <span class="hint">(DF by category, per p.24; enter an override to differ)</span></h3>
  <div class="saves-grid">
    {{#each system.saves as |save key|}}
    <div class="save">
      <label>{{save.label}} (DF {{save.df}})</label>
      <input type="number" name="system.saves.{{key}}.dfOverride" value="{{save.dfOverride}}" placeholder="DF" title="DF override" class="skill-pf"/>
      <input type="number" name="system.saves.{{key}}.value" value="{{save.value}}" placeholder="0" title="Save bonus"/>
      <button type="button" data-action="rollSave" data-save="{{key}}">
        <i class="fas fa-dice-d20"></i> Roll
      </button>
    </div>
    {{/each}}
  </div>

  {{#if isMonster}}
  <h3>Experience &amp; Features</h3>
  <div class="combat-stats">
    <div class="stat">
      <label>EXP</label>
      <input type="number" name="system.exp.value" value="{{system.exp.value}}"/>
    </div>
    <div class="stat">
      <label>EXP Range</label>
      <input type="text" name="system.exp.range" value="{{system.exp.range}}" placeholder="1020-1130"/>
    </div>
  </div>
  <div class="form-group">
    <label>Features</label>
    <textarea name="system.features" rows="3" placeholder="Raze: 12% (stone club)">{{system.features}}</textarea>
  </div>
  {{/if}}

  <h3>Attributes</h3>
  <div class="attributes-grid">
    {{#each system.attributes as |attr key|}}
    <div class="attribute-simple">
      <label>{{attr.label}}</label>
      <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}"/>
    </div>
    {{/each}}
  </div>

  <div class="biography">
    <h3>Biography</h3>
    <prose-mirror name="system.biography" value="{{system.biography}}" toggled>
      {{{enrichedBiography}}}
    </prose-mirror>
  </div>
</section>
</div>
