<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}" height="64" width="64"/>
  <div class="header-fields">
    <h1 class="charname">
      <input name="name" type="text" value="{{item.name}}" placeholder="Weapon Name"/>
    </h1>
  </div>
</header>

<nav class="sheet-tabs tabs" data-group="primary">
  <a class="item {{tabs.description.cssClass}}" data-action="tab" data-group="primary" data-tab="description">Description</a>
  <a class="item {{tabs.details.cssClass}}" data-action="tab" data-group="primary" data-tab="details">Details</a>
</nav>

<section class="sheet-body">
  <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
    <prose-mirror name="system.description" value="{{system.description}}" toggled>
      {{{enrichedDescription}}}
    </prose-mirror>
  </div>

  <div class="tab {{tabs.details.cssClass}}" data-group="primary" data-tab="details">
    <div class="form-group">
      <label>Weapon Skill</label>
      <select name="system.weaponSkill">
        {{selectOptions weaponSkills selected=system.weaponSkill}}
      </select>
    </div>

    <div class="form-group">
      <label>Damage</label>
      <input type="text" name="system.damage" value="{{system.damage}}" placeholder="1d6"/>
    </div>

    <div class="form-group">
      <label>Range</label>
      <input type="text" name="system.range" value="{{system.range}}" placeholder="Melee"/>
    </div>

    <div class="form-group">
      <label>Properties</label>
      <input type="text" name="system.properties" value="{{system.properties}}" placeholder="Two-handed, etc."/>
    </div>

    <div class="form-group">
      <label>Cost (Gold)</label>
      <input type="number" name="system.cost.gold" value="{{system.cost.gold}}"/>
    </div>

    <div class="form-group">
      <label>Cost (Silver)</label>
      <input type="number" name="system.cost.silver" value="{{system.cost.silver}}"/>
    </div>

    <div class="form-group">
      <label>Weight</label>
      <input type="number" name="system.weight" value="{{system.weight}}" step="any"/>
    </div>

    <div class="form-group">
      <label>
        <input type="checkbox" name="system.equipped" {{checked system.equipped}}/>
        Equipped
      </label>
    </div>
  </div>
</section>
